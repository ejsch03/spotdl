// spotdl's desktop window. The Rust side (src/gui/main.rs) owns all state and logic;
// this file only lays it out and forwards clicks.

import { ListView, Palette } from "std-widgets.slint";
import { Theme, ThemeColors, Button, LineEdit, ComboBox, ProgressIndicator, Spinner } from "widgets.slint";

// for the Rust side, which sets the theme
export { Theme, ThemeColors }

export enum JobState { queued, active, done, failed }

export struct ResultRow {
    title: string,
    subtitle: string,
    detail: string,
    queued: bool,
    // everything it would download is already in the download folder
    downloaded: bool,
    // empty until it has loaded (or if there's none); `initial` stands in meanwhile
    image: image,
    initial: string,
    // artists get round pictures
    round: bool,
}

export struct JobRow {
    id: int,
    title: string,
    status: string,
    detail: string,
    progress: float,
    state: JobState,
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: self.height / 2;
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.border;
    background: root.selected ? Theme.accent : touch.has-hover ? Theme.faint : transparent;

    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-size: 13px;
        color: root.selected ? Theme.accent-foreground : Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Thumbnail inherits Rectangle {
    in property <image> source;
    in property <string> initial;
    in property <bool> round;

    width: 44px;
    height: 44px;
    border-radius: root.round ? self.width / 2 : 4px;
    clip: true;
    background: Theme.faint;

    if root.source.width == 0: Text {
        width: 100%;
        height: 100%;
        text: root.initial;
        font-size: 18px;
        font-weight: 600;
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
}

component ResultItem inherits Rectangle {
    in property <ResultRow> hit;
    callback download();

    height: 60px;
    border-radius: 6px;
    background: hover.has-hover ? Theme.faint : transparent;

    hover := TouchArea { }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Thumbnail {
                source: root.hit.image;
                initial: root.hit.initial;
                round: root.hit.round;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.hit.title;
                color: Theme.foreground;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.hit.subtitle;
                font-size: 12px;
                color: Theme.muted;
                overflow: elide;
            }
        }

        Text {
            text: root.hit.detail;
            font-size: 12px;
            color: Theme.muted;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Button {
                // the same width whatever it says, so the rows line up
                min-width: 108px;
                text: root.hit.queued ? "Queued" : root.hit.downloaded ? "Downloaded" : "Download";
                enabled: !root.hit.queued && !root.hit.downloaded;
                clicked => {
                    root.download();
                }
            }
        }
    }
}

component JobItem inherits Rectangle {
    in property <JobRow> job;
    callback cancel();

    border-radius: 6px;
    background: Theme.faint;

    VerticalLayout {
        padding: 10px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.job.title;
                color: Theme.foreground;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.job.state == JobState.queued || root.job.state == JobState.active: Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }
        }

        if root.job.state == JobState.active: ProgressIndicator {
            progress: root.job.progress;
        }

        Text {
            text: root.job.status;
            font-size: 12px;
            overflow: elide;
            color: root.job.state == JobState.failed ? Theme.bad : root.job.state == JobState.done ? Theme.good : Theme.muted;
        }

        if root.job.detail != "": Text {
            text: root.job.detail;
            font-size: 12px;
            color: Theme.bad;
            wrap: word-wrap;
        }
    }
}

export component AppWindow inherits Window {
    title: "spotdl";
    // X11 shows this; on Wayland the desktop finds the icon through the app id (spotdl)
    icon: @image-url("../assets/icon/png/spotdl-256.png");
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.background;

    // logging in
    in property <bool> logged-in;
    in property <bool> busy-connecting;
    in property <bool> has-saved-login;
    in property <string> account;
    in property <string> login-error;
    // Spotify's login page while a browser login is under way, else empty
    in property <string> login-url;
    // the address the login ended on, when pasted (the browser runs elsewhere)
    in-out property <string> login-paste;
    // shown across the top when downloading had to stop
    in property <string> banner;

    // searching
    in-out property <string> query;
    in property <bool> searching;
    in property <string> search-status;
    in property <[ResultRow]> results;
    in-out property <int> filter;

    // downloading
    in property <[JobRow]> jobs;
    in-out property <string> output-dir;
    in-out property <int> format-index;
    // while the folder picker is open
    in property <bool> choosing-folder;
    // downloads are paused (Queue ▾ → Pause all)
    in property <bool> paused;

    // Settings: the developer app, for searching albums, artists and playlists
    in-out property <bool> settings-open;
    in-out property <string> app-client-id;
    in-out property <string> app-client-secret;
    // one is saved (so it can be removed)
    in property <bool> app-saved;
    // checking the typed one with Spotify
    in property <bool> app-checking;
    in property <string> app-status;
    in property <bool> app-status-bad;
    // SPOTDL_CLIENT_ID and SPOTDL_CLIENT_SECRET are set, and win at startup
    in property <bool> app-from-environment;
    // Settings: the themes' names, and which one is showing
    in property <[string]> theme-names;
    in-out property <int> theme-index;

    // Slint still draws the scroll bars and menus itself; they go light or dark with the
    // theme rather than with the system
    property <bool> dark-theme: Theme.dark;
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-theme => {
        Palette.color-scheme = self.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    callback log-in();
    callback reconnect();
    callback cancel-login();
    callback open-login-page();
    callback paste-login-address(string);
    callback open-settings();
    callback save-developer-app();
    callback remove-developer-app();
    callback open-developer-dashboard();
    callback search(string);
    callback filter-changed(int);
    callback download(int);
    callback show-playlists();
    callback cancel-job(int);
    callback clear-finished();
    callback pause-all();
    callback resume-all();
    callback cancel-all();
    callback choose-folder();
    callback open-folder();
    // typing in the folder box (the app waits for a pause before acting on it)
    callback output-dir-edited();
    callback format-changed();
    // a theme was chosen in Settings, by its place in theme-names
    callback theme-changed(int);
    // invoked from Rust when a job ends, so the Rust side can update the results
    callback job-finished(int);

    if !root.logged-in: VerticalLayout {
        width: root.width;
        height: root.height;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: 460px;
                spacing: 14px;

                Text {
                    text: "spotdl";
                    color: Theme.foreground;
                    font-size: 28px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.login-url != "" ? "Log in to Spotify in your browser. spotdl carries on by itself once you're done." : root.busy-connecting ? "Connecting to Spotify…" : "Log in with your Spotify Premium account. Your browser opens once, and the login is remembered.";
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                if root.busy-connecting: HorizontalLayout {
                    alignment: center;
                    Spinner {
                        width: 32px;
                        height: 32px;
                    }
                }

                if root.login-url != "": HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Button {
                        text: "Open the login page again";
                        clicked => {
                            root.open-login-page();
                        }
                    }

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.cancel-login();
                        }
                    }
                }

                if !root.busy-connecting: Button {
                    text: "Log in with Spotify";
                    primary: true;
                    clicked => {
                        root.log-in();
                    }
                }

                if !root.busy-connecting && root.has-saved-login: Button {
                    text: "Try the saved login again";
                    clicked => {
                        root.reconnect();
                    }
                }

                if root.login-error != "": Text {
                    text: root.login-error;
                    color: Theme.bad;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                // for a browser on another computer, or one that can't reach spotdl
                if root.login-url != "": VerticalLayout {
                    padding-top: 12px;
                    spacing: 6px;

                    Text {
                        text: "Using a browser on another computer? Open this link there:";
                        font-size: 12px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }

                    LineEdit {
                        text: root.login-url;
                        read-only: true;
                    }

                    Text {
                        text: "When the login ends on a page that doesn't load, copy that page's address and paste it here:";
                        font-size: 12px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            placeholder-text: "http://127.0.0.1:8898/login?code=…";
                            text <=> root.login-paste;
                            accepted(text) => {
                                root.paste-login-address(text);
                            }
                        }

                        Button {
                            text: "Continue";
                            enabled: root.login-paste != "";
                            clicked => {
                                root.paste-login-address(root.login-paste);
                            }
                        }
                    }
                }
            }
        }
    }

    if root.logged-in: VerticalLayout {
        width: root.width;
        height: root.height;
        padding: 14px;
        spacing: 10px;

        if root.banner != "": Rectangle {
            border-radius: 6px;
            background: Theme.bad.with-alpha(0.15);
            border-width: 1px;
            border-color: Theme.bad;

            HorizontalLayout {
                padding: 10px;
                Text {
                    text: root.banner;
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            LineEdit {
                placeholder-text: "Search songs, albums, artists and playlists, or paste a Spotify link";
                text <=> root.query;
                accepted(text) => {
                    root.search(text);
                }
            }

            Button {
                text: "Search";
                primary: true;
                clicked => {
                    root.search(root.query);
                }
            }

            Button {
                text: "Your playlists";
                enabled: root.logged-in;
                clicked => {
                    root.show-playlists();
                }
            }

            Button {
                text: "Settings";
                clicked => {
                    root.open-settings();
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;

            for name[i] in ["All", "Songs", "Albums", "Artists", "Playlists"]: Chip {
                text: name;
                selected: root.filter == i;
                clicked => {
                    root.filter = i;
                    root.filter-changed(i);
                }
            }

            Text {
                text: root.results.length > 0 ? root.search-status : "";
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                ListView {
                    for row[i] in root.results: ResultItem {
                        hit: row;
                        download => {
                            root.download(i);
                        }
                    }
                }

                if root.results.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    padding: 24px;

                    if root.searching: HorizontalLayout {
                        alignment: center;
                        Spinner {
                            width: 28px;
                            height: 28px;
                        }
                    }

                    Text {
                        text: root.search-status;
                        color: Theme.muted;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }

            VerticalLayout {
                width: 340px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.paused ? "Downloads · Paused" : "Downloads";
                        color: Theme.foreground;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    queue-menu := ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "Pause all";
                                enabled: !root.paused;
                                activated => {
                                    root.pause-all();
                                }
                            }

                            MenuItem {
                                title: "Resume all";
                                enabled: root.paused;
                                activated => {
                                    root.resume-all();
                                }
                            }

                            MenuSeparator { }

                            MenuItem {
                                title: "Cancel all";
                                activated => {
                                    root.cancel-all();
                                }
                            }
                        }

                        queue-button := Button {
                            text: "Queue ▾";
                            clicked => {
                                queue-menu.show({ x: 0, y: queue-button.height });
                            }
                        }
                    }

                    Button {
                        text: "Clear finished";
                        clicked => {
                            root.clear-finished();
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;

                    ListView {
                        for job in root.jobs: VerticalLayout {
                            padding: 6px;
                            JobItem {
                                job: job;
                                cancel => {
                                    root.cancel-job(job.id);
                                }
                            }
                        }
                    }

                    if root.jobs.length == 0: Text {
                        width: 100%;
                        height: 100%;
                        text: "Nothing queued yet.\nPick something on the left.";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Save to";
                color: Theme.foreground;
                vertical-alignment: center;
            }

            LineEdit {
                text <=> root.output-dir;
                horizontal-stretch: 1;
                edited => {
                    root.output-dir-edited();
                }
            }

            Button {
                text: "Choose…";
                enabled: !root.choosing-folder;
                clicked => {
                    root.choose-folder();
                }
            }

            Button {
                text: "Open";
                clicked => {
                    root.open-folder();
                }
            }

            Text {
                text: "Format";
                color: Theme.foreground;
                vertical-alignment: center;
            }

            ComboBox {
                width: 160px;
                model: ["Ogg (original)", "FLAC", "MP3", "Opus"];
                current-index <=> root.format-index;
                selected => {
                    root.format-changed();
                }
            }

            Text {
                text: root.account;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                // shortened with … rather than cut off when the window is narrow
                overflow: elide;
                min-width: 60px;
            }
        }
    }

    if root.settings-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;

        // clicks outside the panel go nowhere
        TouchArea { }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: min(620px, root.width - 40px);
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.background;

                    VerticalLayout {
                        padding: 22px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Settings";
                                color: Theme.foreground;
                                font-size: 20px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: "Theme";
                                color: Theme.muted;
                                vertical-alignment: center;
                            }

                            ComboBox {
                                width: 200px;
                                model: root.theme-names;
                                current-index <=> root.theme-index;
                                selected => {
                                    root.theme-changed(self.current-index);
                                }
                            }
                        }

                        Text {
                            text: "Search albums, artists and playlists";
                            color: Theme.foreground;
                            font-size: 15px;
                            font-weight: 600;
                        }

                        Text {
                            text: "Out of the box, search finds songs, and the albums and artists they're on. To search albums, artists and playlists directly, spotdl needs a Spotify developer app of your own. It's free and takes a couple of minutes:";
                            color: Theme.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "1. Open Spotify's developer dashboard, and log in with your Spotify account if it asks.";
                                color: Theme.foreground;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Open the dashboard";
                                    clicked => {
                                        root.open-developer-dashboard();
                                    }
                                }
                            }
                        }

                        Text {
                            text: "2. Choose Create app. Any name and description will do. For the redirect URI, enter http://127.0.0.1:8888/callback (spotdl doesn't use it). Tick Web API, accept the terms, and save.";
                            color: Theme.foreground;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "3. In the app's settings, copy its Client ID and its Client secret (under View client secret) into the boxes below.";
                            color: Theme.foreground;
                            wrap: word-wrap;
                        }

                        GridLayout {
                            spacing: 8px;
                            Row {
                                Text {
                                    text: "Client ID";
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.app-client-id;
                                    placeholder-text: "paste the Client ID";
                                }
                            }

                            Row {
                                Text {
                                    text: "Client secret";
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.app-client-secret;
                                    input-type: password;
                                    placeholder-text: root.app-saved ? "saved (paste a new one to change it)" : "paste the Client secret";
                                    accepted => {
                                        root.save-developer-app();
                                    }
                                }
                            }
                        }

                        if root.app-status != "": Text {
                            text: root.app-status;
                            color: root.app-checking ? Theme.muted : root.app-status-bad ? Theme.bad : Theme.good;
                            wrap: word-wrap;
                        }

                        if root.app-from-environment: Text {
                            text: "SPOTDL_CLIENT_ID and SPOTDL_CLIENT_SECRET are set, so when spotdl starts it uses those rather than what's saved here.";
                            font-size: 12px;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            if root.app-saved: Button {
                                text: "Remove";
                                enabled: !root.app-checking;
                                clicked => {
                                    root.remove-developer-app();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            if root.app-checking: VerticalLayout {
                                alignment: center;
                                Spinner {
                                    width: 20px;
                                    height: 20px;
                                }
                            }

                            Button {
                                text: "Close";
                                clicked => {
                                    root.settings-open = false;
                                }
                            }

                            Button {
                                text: "Save";
                                primary: true;
                                enabled: !root.app-checking;
                                clicked => {
                                    root.save-developer-app();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
